<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="UrbanPlanToolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UrbanPlanToolbox">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="#E5F9F9" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppTransientSurfaceBrush" Color="#E5F9F9" />
                    <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="AppTransientSurfaceBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="#1A2323" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppTransientSurfaceBrush" Color="#1A2323" />
                    <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="AppTransientSurfaceBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <StaticResource x:Key="AppTransientSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
                    <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="PageContentPadding">32</Thickness>
            <Thickness x:Key="CardContentPadding">16</Thickness>
            <x:Double x:Key="PageSectionSpacing">16</x:Double>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CardFocusCornerRadius">4</CornerRadius>
            <Style x:Key="PageContentStackPanelStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="{StaticResource PageContentPadding}" />
                <Setter Property="Spacing" Value="{StaticResource PageSectionSpacing}" />
            </Style>
            <Style x:Key="CardActionButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>
            <Style x:Key="StatusBadgeStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardContentPadding}" />
            </Style>
            <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
