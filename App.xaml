<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="UrbanPlanToolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UrbanPlanToolbox">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="PageContentPadding">32</Thickness>
            <Thickness x:Key="CardContentPadding">16</Thickness>
            <x:Double x:Key="PageSectionSpacing">16</x:Double>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <Style x:Key="PageContentStackPanelStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="{StaticResource PageContentPadding}" />
                <Setter Property="Spacing" Value="{StaticResource PageSectionSpacing}" />
            </Style>
            <Style x:Key="CardActionButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>
            <Style x:Key="StatusBadgeStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
