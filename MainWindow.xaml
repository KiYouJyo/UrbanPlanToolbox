<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="UrbanPlanToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UrbanPlanToolbox"
    xmlns:views="using:UrbanPlanToolbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UrbanPlanToolbox"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Loaded="OnRootLayoutLoaded">
        <Grid x:Name="MainContent" Opacity="0" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar" Title="UrbanPlanToolbox">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon-Small-Dark-256.png" />
                </TitleBar.IconSource>
            </TitleBar>

            <!-- The shell prepares behind the transparent startup overlay. -->
            <Frame x:Name="RootFrame" Grid.Row="1" />
            <InfoBar x:Name="NotificationBar" Grid.Row="1" Margin="24" VerticalAlignment="Top"
                     HorizontalAlignment="Stretch" IsOpen="False" IsClosable="True" />
            <views:FirstRunGuideHost x:Name="FirstRunGuide" Grid.RowSpan="2" Canvas.ZIndex="10" />
        </Grid>
        <Grid x:Name="StartupOverlay" Background="Transparent" Canvas.ZIndex="100">
            <Image x:Name="StartupDarkLogo"
                   Source="ms-appx:///Assets/Icon-Large-Dark-1024.png"
                   Width="183"
                   Height="183"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   ImageOpened="OnStartupLogoImageOpened"
                   ImageFailed="OnStartupLogoImageFailed" />
            <Image x:Name="StartupLightLogo"
                   Source="ms-appx:///Assets/Icon-Large-Light-1024.png"
                   Width="183"
                   Height="183"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   ImageOpened="OnStartupLogoImageOpened"
                   ImageFailed="OnStartupLogoImageFailed" />
        </Grid>
    </Grid>
</Window>
