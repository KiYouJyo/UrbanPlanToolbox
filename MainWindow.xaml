<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="UrbanPlanToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UrbanPlanToolbox"
    xmlns:views="using:UrbanPlanToolbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UrbanPlanToolbox"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Loaded="OnRootLayoutLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="UrbanPlanToolbox">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/UrbanPlanToolbox.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
        <InfoBar x:Name="NotificationBar" Grid.Row="1" Margin="24" VerticalAlignment="Top"
                 HorizontalAlignment="Stretch" IsOpen="False" IsClosable="True"
                 />
        <views:FirstRunGuideHost x:Name="FirstRunGuide" Grid.RowSpan="2" Canvas.ZIndex="10" />
        <Grid x:Name="StartupOverlay" Grid.RowSpan="2" Background="#202020" Canvas.ZIndex="100">
            <Image x:Name="StartupLogo"
                   Source="ms-appx:///Assets/SplashScreen.scale-200.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   ImageOpened="OnStartupLogoImageOpened"
                   ImageFailed="OnStartupLogoImageFailed" />
        </Grid>
    </Grid>
</Window>
