<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UrbanPlanToolbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UrbanPlanToolbox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="Navigation" AlwaysShowHeader="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" Loaded="OnNavigationLoaded" ItemInvoked="OnNavigationItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="WelcomeItem" Tag="welcome" Icon="Home" />
            <NavigationViewItem x:Name="SearchItem" Tag="common-tools" Icon="Find" />
            <NavigationViewItem x:Name="DesignItem" Tag="design-tools" Icon="Edit" />
            <NavigationViewItem x:Name="ResearchItem" Tag="research-tools" Icon="Library" />
            <NavigationViewItem x:Name="ArchiveItem" Tag="project-archive" Icon="Folder" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="AboutItem" Tag="about" Icon="Help" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
