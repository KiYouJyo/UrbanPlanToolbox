<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UrbanPlanToolbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UrbanPlanToolbox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="Navigation" AlwaysShowHeader="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" Loaded="OnNavigationLoaded" ItemInvoked="OnNavigationItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="欢迎页面" Tag="welcome" Icon="Home" />
            <NavigationViewItem Content="常用功能" Tag="common-tools" Icon="Favorite" />
            <NavigationViewItem Content="设计工具" Tag="design-tools" Icon="Edit" />
            <NavigationViewItem Content="科研工具" Tag="research-tools" Icon="Library" />
            <NavigationViewItem Content="项目归档" Tag="project-archive" Icon="Folder" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
