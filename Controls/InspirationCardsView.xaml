<UserControl x:Class="UrbanPlanToolbox.Controls.InspirationCardsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12"><TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}"/><ItemsRepeater x:Name="Cards"><ItemsRepeater.ItemTemplate><DataTemplate><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnCardClick"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{Binding CategoryText}" Opacity="0.7"/><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Updated}" Opacity="0.7"/></StackPanel></Button></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater></StackPanel>
</UserControl>
