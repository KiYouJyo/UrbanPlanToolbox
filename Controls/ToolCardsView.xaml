<UserControl
    x:Class="UrbanPlanToolbox.Controls.ToolCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UrbanPlanToolbox.Controls">
    <ItemsRepeater x:Name="CardsRepeater">
        <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemHeight="156"
                MinItemWidth="280"
                ItemsJustification="Start"
                ItemsStretch="Fill" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,0,12,12">
                    <Button
                        AutomationProperties.Name="{Binding DisplayName}"
                        Click="OnToolCardClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="20"
                        Tag="{Binding}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <Grid ColumnSpacing="16" Padding="0,0,40,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="{Binding IconGlyph}"
                                FontSize="28"
                                VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding Description}"
                                    MaxLines="3"
                                    Opacity="0.75"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock Text="打开" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <controls:FavoriteButton
                        ToolId="{Binding Id}"
                        HorizontalAlignment="Right"
                        Margin="0,12,12,0"
                        VerticalAlignment="Top" />
                </Grid>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
