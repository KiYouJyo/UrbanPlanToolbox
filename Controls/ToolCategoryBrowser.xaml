<UserControl
    x:Class="UrbanPlanToolbox.Controls.ToolCategoryBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <ListView
            x:Name="CategoryList"
            IsItemClickEnabled="True"
            SelectionChanged="OnCategorySelectionChanged"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" Margin="8,2" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ItemsRepeater x:Name="ToolCards">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinItemHeight="148"
                    MinItemWidth="280"
                    ItemsJustification="Start"
                    ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <Button
                        AutomationProperties.Name="{Binding DisplayName}"
                        Click="OnToolCardClick"
                        HorizontalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="20"
                        Tag="{Binding}"
                        VerticalContentAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="{Binding IconGlyph}"
                                FontSize="28"
                                VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding Description}"
                                    MaxLines="3"
                                    Opacity="0.75"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock Text="打开" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <InfoBar
            x:Name="EmptyState"
            IsClosable="False"
            IsOpen="False"
            Message="当前分类暂无已上线工具。"
            Severity="Informational" />
    </StackPanel>
</UserControl>
