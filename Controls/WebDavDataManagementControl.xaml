<UserControl
    x:Class="UrbanPlanToolbox.Controls.WebDavDataManagementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <StackPanel Spacing="3">
      <TextBlock x:Name="WebDavTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock x:Name="WebDavDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Spacing="2">
      <TextBlock x:Name="WebDavStatusLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
      <TextBlock x:Name="WebDavStatusValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="WebDavBackupButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Click="OnCreateCloudBackup" />
      <Button x:Name="WebDavRestoreButton" Grid.Column="1" Click="OnRestoreFromCloud" />
      <Button x:Name="WebDavManageButton" Grid.Column="2" Click="OnManageCloudBackups" />
      <Button x:Name="WebDavConfigureButton" Grid.Column="3" Click="OnConfigureWebDav" />
    </Grid>
    <InfoBar x:Name="WebDavStatusBar" IsOpen="False" />
  </StackPanel>
</UserControl>