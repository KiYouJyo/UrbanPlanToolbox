<Page x:Class="UrbanPlanToolbox.Views.CommonToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer>
    <StackPanel Padding="32" Spacing="16">
      <TextBlock Text="工具搜索" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="浏览全部已上线工具，支持中文、拼音和关键词搜索。" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" PlaceholderText="搜索工具" TextChanged="OnSearchTextChanged" /><Button Grid.Column="1" Content="清除" Click="OnClearSearch" /></Grid>
      <controls:ToolSearchList x:Name="ToolList" />
      <InfoBar x:Name="EmptyState" IsClosable="False" IsOpen="False" Severity="Informational" Title="未找到匹配的工具" Message="请尝试其他关键词。" />
    </StackPanel>
  </ScrollViewer>
</Page>
