<Page x:Class="UrbanPlanToolbox.Views.CommonToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer>
    <StackPanel Padding="32" Spacing="16">
      <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Uid="Page_Search_Description" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" x:Uid="Search_Placeholder" TextChanged="OnSearchTextChanged" /><Button Grid.Column="1" x:Uid="Action_ClearSearch" Click="OnClearSearch" /></Grid>
      <controls:ToolSearchList x:Name="ToolList" />
      <InfoBar x:Name="EmptyState" x:Uid="Status_NoSearchResults" IsClosable="False" IsOpen="False" Severity="Informational" />
    </StackPanel>
  </ScrollViewer>
</Page>
