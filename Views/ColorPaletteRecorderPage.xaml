<Page x:Class="UrbanPlanToolbox.Views.ColorPaletteRecorderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer>
    <StackPanel Style="{StaticResource PageContentStackPanelStyle}" Spacing="16">
      <StackPanel x:Name="ListPanel" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Width="620"><TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
          <Button x:Name="NewButton" Click="OnNew" VerticalAlignment="Bottom" />
        </StackPanel>
        <ComboBox x:Name="CategoryFilter" SelectionChanged="OnFilterChanged" />
        <InfoBar x:Name="ListStatus" IsOpen="False" IsClosable="True" />
        <StackPanel x:Name="CardsPanel" Spacing="10" />
      </StackPanel>
      <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="BackButton" Click="OnBack"/><TextBlock x:Name="EditorTitle" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
        <TextBox x:Name="SchemeNameBox" TextChanged="OnChanged" />
        <ComboBox x:Name="CategoryBox" SelectionChanged="OnCategoryChanged" />
        <TextBox x:Name="CustomCategoryBox" TextChanged="OnChanged" Visibility="Collapsed" />
        <TextBlock x:Name="ImagesTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><Button x:Name="AddImagesButton" Click="OnAddImages" HorizontalAlignment="Left"/>
        <InfoBar x:Name="EditorStatus" IsOpen="False" IsClosable="True" />
        <ItemsControl x:Name="ImagesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <TextBlock x:Name="ColorsTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><Button x:Name="AddColorButton" Click="OnAddColor" HorizontalAlignment="Left"/>
        <StackPanel x:Name="ColorsPanel" Spacing="8"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveButton" Click="OnSave"/><Button x:Name="ResetButton" Click="OnReset"/></StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
