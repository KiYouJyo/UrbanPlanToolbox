<Page x:Class="UrbanPlanToolbox.Views.CoordinateSystemConverterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Style="{StaticResource PageContentStackPanelStyle}" Spacing="12">
      <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
      <Pivot x:Name="ModePivot">
        <PivotItem x:Name="SinglePointPivot" />
        <PivotItem x:Name="ShapefilePivot"><StackPanel Spacing="8"><TextBlock x:Name="ShapefileDescriptionText" TextWrapping="Wrap" /><TextBlock x:Name="ShapefilePrivacyText" TextWrapping="Wrap" /><Button x:Name="SelectShapefileButton" Click="OnSelectShapefile" /><TextBlock x:Name="SelectedShapefileText" TextWrapping="Wrap" /><TextBlock x:Name="CompanionStatusText" TextWrapping="Wrap" /><ComboBox x:Name="ShapefileSourceBox" /><ComboBox x:Name="ShapefileTargetBox" /><Button x:Name="SelectOutputFolderButton" Click="OnSelectOutputFolder" /><TextBox x:Name="OutputNameBox" /><TextBlock x:Name="OutputFolderText" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConvertShapefileButton" Click="OnConvertShapefile" /><Button x:Name="CancelShapefileButton" Click="OnCancelShapefile" IsEnabled="False" /></StackPanel><ProgressBar x:Name="ShapefileProgress" IsIndeterminate="True" Visibility="Collapsed" /><TextBlock x:Name="ShapefileProgressText" TextWrapping="Wrap" /><Button x:Name="OpenOutputFolderButton" Click="OnOpenOutputFolder" IsEnabled="False" /></StackPanel></PivotItem>
      </Pivot>
      <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <ComboBox x:Name="SourceSystemBox" Grid.Column="0" />
        <ComboBox x:Name="TargetSystemBox" Grid.Column="1" />
        <TextBox x:Name="LongitudeBox" Grid.Row="1" Grid.Column="0" InputScope="Number" />
        <TextBox x:Name="LatitudeBox" Grid.Row="1" Grid.Column="1" InputScope="Number" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SwapButton" Click="OnSwap" /><Button x:Name="ConvertButton" Click="OnConvert" /><Button x:Name="ClearButton" Click="OnClear" /><Button x:Name="SampleButton" Click="OnSample" /></StackPanel>
      <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="18" />
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CopyLongitudeButton" Click="OnCopyLongitude" /><Button x:Name="CopyLatitudeButton" Click="OnCopyLatitude" /><Button x:Name="CopyCoordinateButton" Click="OnCopyCoordinate" /></StackPanel>
      <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
