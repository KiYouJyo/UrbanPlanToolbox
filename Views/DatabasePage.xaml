<Page x:Class="UrbanPlanToolbox.Views.DatabasePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Style="{StaticResource PageContentStackPanelStyle}">
  <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
  <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" />
  <ListView x:Name="Regions" SelectionMode="Single" SelectionChanged="OnRegionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.VerticalScrollMode="Disabled">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
  </ListView>
  <ItemsRepeater x:Name="Countries">
   <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="280" ItemsJustification="Start" ItemsStretch="Fill" /></ItemsRepeater.Layout>
   <ItemsRepeater.ItemTemplate><DataTemplate>
    <Button Margin="0,0,12,12" Style="{StaticResource CardActionButtonStyle}" Click="OnCountryClick" Tag="{Binding Code}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE909;" FontSize="28" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{Binding Description}" Opacity="0.75" TextWrapping="WrapWholeWords"/></StackPanel>
     </Grid>
    </Button>
   </DataTemplate></ItemsRepeater.ItemTemplate>
  </ItemsRepeater>
  <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Opacity="0.7" />
 </StackPanel></ScrollViewer>
</Page>
