<Page
    x:Class="UrbanPlanToolbox.Views.ProjectWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnRound6WorkspaceLoaded"
    SizeChanged="OnPageSizeChanged">

  <Grid>
    <ScrollViewer x:Name="WorkspaceScrollViewer"
                  HorizontalContentAlignment="Stretch"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid x:Name="WorkspaceContent"
            Padding="{StaticResource PageContentPadding}"
            RowSpacing="16"
            MaxWidth="1400"
            Width="{Binding ViewportWidth, ElementName=WorkspaceScrollViewer}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
          <Button x:Name="BackButton" Click="OnBack" HorizontalAlignment="Left"/>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                <Border x:Name="KindBadge" Padding="8,4" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <TextBlock x:Name="KindText" FontSize="12" Opacity="0.78"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="MetadataText" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Border x:Name="StateBadge" Style="{StaticResource StatusBadgeStyle}">
                <TextBlock x:Name="StateText"/>
              </Border>
              <Button x:Name="EditOverviewButton" Click="OnEditOverview"/>
              <Button x:Name="MoreButton" Content="⋯" MinWidth="40">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="ArchiveMenuItem" Click="OnArchive"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Click="OnDeleteProject"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>

        <Border x:Name="OverviewCard" Grid.Row="2" Style="{StaticResource SettingsSectionCardStyle}" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="OverviewTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border x:Name="OverviewPhaseBadge" Visibility="Collapsed" Padding="8,3" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <TextBlock x:Name="OverviewPhaseText" FontSize="12" Opacity="0.78"/>
                </Border>
              </StackPanel>
              <Button x:Name="EditOverviewCompactButton" Grid.Column="1" Click="OnEditOverview"/>
            </Grid>
            <ScrollViewer MaxHeight="96"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="OverviewDescriptionText" TextWrapping="Wrap" Opacity="0.82"/>
            </ScrollViewer>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,9">
                <StackPanel Spacing="2"><TextBlock x:Name="OverviewLabel1" FontSize="11" Opacity="0.58"/><TextBlock x:Name="OverviewValue1" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,9">
                <StackPanel Spacing="2"><TextBlock x:Name="OverviewLabel2" FontSize="11" Opacity="0.58"/><TextBlock x:Name="OverviewValue2" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,9">
                <StackPanel Spacing="2"><TextBlock x:Name="OverviewLabel3" FontSize="11" Opacity="0.58"/><TextBlock x:Name="OverviewValue3" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,9">
                <StackPanel Spacing="2"><TextBlock x:Name="OverviewLabel4" FontSize="11" Opacity="0.58"/><TextBlock x:Name="OverviewValue4" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12" Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock x:Name="WorkspaceTitleText" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="WorkspaceSubtitleText" TextWrapping="Wrap" Opacity="0.62"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="UndoLayoutButton" Click="OnUndoLayout" Visibility="Collapsed"/>
            <Button x:Name="ResetLayoutButton" Click="OnResetLayout"/>
            <Button x:Name="AddPanelButton" Click="OnAddPanel"/>
          </StackPanel>
        </Grid>

        <Border x:Name="WorkspaceSurface" Grid.Row="4" Padding="0">
          <Canvas x:Name="TileCanvas" MinHeight="0" HorizontalAlignment="Stretch" Background="Transparent" Tapped="OnWorkspaceCanvasTapped" SizeChanged="OnTileCanvasSizeChanged"/>
        </Border>

        <TextBlock x:Name="ArchivedNotice" Grid.Row="5" TextWrapping="Wrap" Opacity="0.68" Visibility="Collapsed"/>
      </Grid>
    </ScrollViewer>

    <Grid x:Name="DrawerLayer" Visibility="Collapsed">
      <Border Background="#66000000" Tapped="OnDrawerScrimTapped"/>
      <Border x:Name="DrawerPane"
              Width="420"
              HorizontalAlignment="Right"
              Background="{ThemeResource AppTransientSurfaceBrush}"
              BorderBrush="{ThemeResource AppTransientSurfaceBorderBrush}"
              BorderThickness="1,0,0,0">
        <Grid Padding="18" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock x:Name="DrawerTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
              <TextBlock x:Name="DrawerSubtitle" TextWrapping="Wrap" Opacity="0.62"/>
            </StackPanel>
            <Button x:Name="DrawerCloseButton" Grid.Column="1" Content="×" Click="OnCloseDrawer" MinWidth="36"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DrawerContent" Spacing="12"/>
          </ScrollViewer>
          <StackPanel x:Name="DrawerFooter" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>