<Page x:Class="UrbanPlanToolbox.Views.ProjectWorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer x:Name="WorkspaceScrollViewer" HorizontalContentAlignment="Stretch"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid x:Name="WorkspaceContent" Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource PageSectionSpacing}" MaxWidth="1400"
          Width="{Binding ViewportWidth, ElementName=WorkspaceScrollViewer}"
          HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Stretch">
        <Button x:Uid="ProjectWorkspace_Back" Click="OnBack" HorizontalAlignment="Left"/>
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="MetadataText" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="StateBadge" Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
            <TextBlock x:Name="StateText"/>
          </Border>
        </Grid>
      </StackPanel>

      <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>

      <Expander x:Name="BasicInfoExpander" Grid.Row="2" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
          <TextBox x:Name="NameBox" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
          <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="TypeBox" DisplayMemberPath="Name" SelectionChanged="OnTypeChanged" HorizontalAlignment="Stretch"/>
          <TextBox x:Name="CustomTypeBox" TextChanged="OnFieldChanged" Visibility="Collapsed" HorizontalAlignment="Stretch"/>

          <!-- Keep retired design fields in the visual tree so legacy project data is preserved on save,
               but do not surface them in the streamlined v1.8.1 workspace. -->
          <Grid Visibility="Collapsed">
            <StackPanel>
              <TextBox x:Name="AreaBox" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
              <TextBlock x:Name="CoordinatesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
              <Grid x:Name="CoordinatesGrid" ColumnSpacing="12" RowSpacing="10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CoordinatesSecondColumn" Width="0"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup>
                    <VisualState x:Name="NarrowCoordinates"/>
                    <VisualState x:Name="WideCoordinates">
                      <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers>
                      <VisualState.Setters>
                        <Setter Target="CoordinatesSecondColumn.Width" Value="*"/>
                        <Setter Target="LongitudeBox.(Grid.Column)" Value="1"/>
                        <Setter Target="LongitudeBox.(Grid.Row)" Value="0"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <TextBox x:Name="LatitudeBox" Grid.Row="0" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
                <TextBox x:Name="LongitudeBox" Grid.Row="1" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Description is now part of the basic-information card for design projects. -->
          <Expander x:Name="DescriptionExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                     TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
          </Expander>
        </StackPanel>
      </Expander>

      <Expander x:Name="ResearchDetailsExpander" Grid.Row="3" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
        <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
          <TextBox x:Name="ResearchFieldBox" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
          <TextBox x:Name="ResearchSubjectBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
          <TextBox x:Name="ResearchMethodsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Expander>

      <!-- Planning requirements are retired from the v1.8.1 UI.  Keep the controls hidden so
           existing values round-trip unchanged instead of being silently discarded. -->
      <Grid Grid.Row="3" Visibility="Collapsed">
        <Expander x:Name="RequirementsExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
            <TextBlock x:Name="RequirementsHelpText" TextWrapping="Wrap"/>
            <TextBox x:Name="PlanningRequirementsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180"
                     TextChanged="OnFieldChanged" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Expander>
      </Grid>

      <Expander x:Name="MilestonesExpander" Grid.Row="4" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
          <Button x:Name="AddMilestoneButton" Click="OnAddMilestone" HorizontalAlignment="Left"/>
          <TextBlock x:Name="MilestoneEmptyText" TextWrapping="Wrap"/>
          <StackPanel x:Name="MilestoneList" Spacing="8" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Expander>

      <Expander x:Name="FolderExpander" Grid.Row="5" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
          <TextBlock x:Name="FolderText" TextWrapping="Wrap"/>
          <Button x:Name="SelectFolderButton" Click="OnSelectFolder" HorizontalAlignment="Left"/>
          <Button x:Name="OpenFolderButton" Click="OnOpenFolder" HorizontalAlignment="Left"/>
          <Button x:Name="ClearFolderButton" Click="OnClearFolder" HorizontalAlignment="Left"/>
        </StackPanel>
      </Expander>

      <Expander x:Name="ManagementExpander" Grid.Row="6" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Padding="0,12,0,4" HorizontalAlignment="Stretch">
          <TextBlock x:Name="ManagementStateText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ArchiveDetailsText" TextWrapping="Wrap"/>
          <Button x:Name="ArchiveButton" Click="OnArchive" HorizontalAlignment="Left"/>
          <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,8"/>
          <TextBlock x:Name="DeleteExplanationText" TextWrapping="Wrap"/>
          <Button x:Name="DeleteButton" Click="OnDeleteProject" HorizontalAlignment="Left"/>
        </StackPanel>
      </Expander>

      <!-- Shared save/reset actions sit at the bottom for both design and research projects. -->
      <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
        <Button x:Name="SaveButton" Click="OnSave"/>
        <Button x:Name="ResetButton" Click="OnReset"/>
        <Grid Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ResearchSaveButton" Click="OnSave"/>
            <Button x:Name="ResearchResetButton" Click="OnReset"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <TextBlock x:Name="LegacyDataNotice" Grid.Row="8" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
  </ScrollViewer>
</Page>