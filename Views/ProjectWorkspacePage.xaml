<Page x:Class="UrbanPlanToolbox.Views.ProjectWorkspacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
    <Button x:Uid="ProjectWorkspace_Back" Click="OnBack" HorizontalAlignment="Left" />
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="MetadataText" TextWrapping="Wrap"/></StackPanel>
      <Border x:Name="StateBadge" Grid.Column="1" Padding="10,5" CornerRadius="12" VerticalAlignment="Top"><TextBlock x:Name="StateText"/></Border>
    </Grid>
    <InfoBar x:Name="StatusBar" IsOpen="False" />

    <Expander x:Uid="ProjectWorkspace_Overview" IsExpanded="True"><StackPanel Spacing="10" Padding="0,12,0,4">
      <TextBox x:Name="NameBox" TextChanged="OnFieldChanged" />
      <ComboBox x:Name="TypeBox" DisplayMemberPath="Name" SelectionChanged="OnTypeChanged" />
      <TextBox x:Name="CustomTypeBox" TextChanged="OnFieldChanged" Visibility="Collapsed" />
      <TextBox x:Name="AreaBox" TextChanged="OnFieldChanged" />
      <TextBlock x:Uid="Project_Coordinates_Wgs84" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="LatitudeBox" TextChanged="OnFieldChanged"/><TextBox x:Name="LongitudeBox" Grid.Column="1" TextChanged="OnFieldChanged"/></Grid>
      <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" TextChanged="OnFieldChanged"/>
      <Button x:Uid="ProjectWorkspace_Save" x:Name="SaveButton" Click="OnSave" HorizontalAlignment="Left" />
    </StackPanel></Expander>

    <Expander x:Uid="ProjectWorkspace_Todos" IsExpanded="True"><StackPanel Spacing="10" Padding="0,12,0,4">
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewTodoBox"/><Button x:Uid="Todo_Add" x:Name="AddTodoButton" Grid.Column="1" Click="OnAddTodo"/></Grid>
      <StackPanel x:Name="TodoList" Spacing="8"/><TextBlock x:Name="TodoEmptyText" x:Uid="Todo_Empty"/>
    </StackPanel></Expander>

    <Expander x:Uid="ProjectWorkspace_Snapshots" IsExpanded="True"><StackPanel Spacing="10" Padding="0,12,0,4">
      <Button x:Uid="Snapshot_OpenCalculator" x:Name="OpenCalculatorButton" Click="OnOpenCalculator" HorizontalAlignment="Left"/>
      <StackPanel x:Name="SnapshotList" Spacing="8"/><TextBlock x:Name="SnapshotEmptyText" x:Uid="Snapshot_Empty"/>
    </StackPanel></Expander>

    <Expander x:Uid="ProjectWorkspace_Folder" IsExpanded="True"><StackPanel Spacing="10" Padding="0,12,0,4">
      <TextBlock x:Name="FolderText" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="Folder_Select" x:Name="SelectFolderButton" Click="OnSelectFolder"/><Button x:Uid="Folder_Open" x:Name="OpenFolderButton" Click="OnOpenFolder"/><Button x:Uid="Folder_Clear" x:Name="ClearFolderButton" Click="OnClearFolder"/></StackPanel>
    </StackPanel></Expander>

    <Expander x:Uid="ProjectWorkspace_Status" IsExpanded="False"><StackPanel Spacing="10" Padding="0,12,0,4"><TextBlock x:Name="ArchiveExplanation" TextWrapping="Wrap"/><Button x:Name="ArchiveButton" Click="OnArchive" HorizontalAlignment="Left"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
</Page>
