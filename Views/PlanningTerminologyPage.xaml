<Page x:Class="UrbanPlanToolbox.Views.PlanningTerminologyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UrbanPlanToolbox.Controls"
      xmlns:local="using:UrbanPlanToolbox.Views">
  <Page.Resources>
    <local:ReferenceFilterLabelConverter x:Key="ReferenceFilterLabelConverter"/>
    <DataTemplate x:Key="ReferenceFilterChoiceTemplate">
      <TextBlock Text="{Binding Display, Converter={StaticResource ReferenceFilterLabelConverter}}"/>
    </DataTemplate>
  </Page.Resources>
  <Grid x:Name="Root" Padding="{StaticResource PageContentPadding}" MaxWidth="1500" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="6">
      <Button x:Name="BackButton" Click="OnBackClick" HorizontalAlignment="Left"/>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
          <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="CloudVersionText" VerticalAlignment="Center" Opacity="0.72" MaxWidth="340" TextWrapping="Wrap"/>
          <controls:AnimatedUpdateButton x:Name="HeaderCheckButton" Click="OnCheckUpdateClick"/>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,14,0,0" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock x:Name="CurrentSourceLabel" FontSize="12" Opacity="0.62"/>
          <TextBlock x:Name="SourceNameText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SourceMetaText" FontSize="12" Opacity="0.76" TextWrapping="Wrap"/>
        </StackPanel>
        <controls:AnimatedUpdateButton x:Name="CheckButton" Grid.Column="1" Click="OnCheckUpdateClick" VerticalAlignment="Center"/>
        <Button x:Name="ManageButton" Grid.Column="2" Click="OnManageSourceClick" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid x:Name="FilterGrid" Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="12" RowSpacing="8">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="FilterLayoutStates">
          <VisualState x:Name="CompactFilters">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="2"/>
              <Setter Target="FilterOptionsPanel.(Grid.Row)" Value="1"/>
              <Setter Target="FilterOptionsPanel.(Grid.Column)" Value="0"/>
              <Setter Target="FilterOptionsPanel.(Grid.ColumnSpan)" Value="2"/>
              <Setter Target="FilterOptionsPanel.Margin" Value="0,2,0,0"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="WideFilters">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="980"/></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1"/>
              <Setter Target="FilterOptionsPanel.(Grid.Row)" Value="0"/>
              <Setter Target="FilterOptionsPanel.(Grid.Column)" Value="1"/>
              <Setter Target="FilterOptionsPanel.(Grid.ColumnSpan)" Value="1"/>
              <Setter Target="FilterOptionsPanel.Margin" Value="0"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0" TextChanged="OnFilterChanged"/>
      <StackPanel x:Name="FilterOptionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="JurisdictionBox" MinWidth="160" MaxWidth="245" ItemTemplate="{StaticResource ReferenceFilterChoiceTemplate}" SelectionChanged="OnSelectionFilterChanged"/>
        <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="CategoryBox" MinWidth="160" MaxWidth="230" ItemTemplate="{StaticResource ReferenceFilterChoiceTemplate}" SelectionChanged="OnSelectionFilterChanged"/>
        <Button x:Name="ResetButton" Click="OnResetFiltersClick"/>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="CountText" Grid.Row="3" Margin="0,8,0,8" FontSize="12" Opacity="0.66"/>

    <Grid x:Name="ContentGrid" Grid.Row="4" ColumnSpacing="16" MinHeight="0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>

      <Border x:Name="ListPanel" Grid.Row="0" Grid.Column="0" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" MinHeight="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,10">
            <TextBlock x:Name="ListHeader" FontSize="16" FontWeight="SemiBold"/>
            <Border Padding="10,3" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock x:Name="ListCountBadge" FontSize="12"/></Border>
          </StackPanel>
          <ListView Grid.Row="1" x:Name="TermsList" SelectionMode="Single" SelectionChanged="OnTermSelectionChanged" HorizontalContentAlignment="Stretch" MinHeight="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,10" MinHeight="92">
                  <StackPanel Spacing="3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ZhCN}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Metadata}" FontSize="10" Opacity="0.62" VerticalAlignment="Top"/></Grid>
                    <TextBlock Text="{Binding JaJP}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EnUS}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" x:Name="EmptyText" Margin="4,8,4,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Border x:Name="DetailPanel" Grid.Row="0" Grid.Column="1" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" MinHeight="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4"><TextBlock x:Name="DetailZh" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailJa" FontSize="17" TextWrapping="Wrap"/><TextBlock x:Name="DetailEn" FontSize="16" Opacity="0.82" TextWrapping="Wrap"/></StackPanel>
              <Border Grid.Column="1" Padding="10,4" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top"><TextBlock x:Name="JurisdictionBadge" FontSize="12"/></Border>
              <Border Grid.Column="2" Padding="10,4" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top"><TextBlock x:Name="EquivalenceBadge" FontSize="12"/></Border>
            </Grid>
            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>
            <TextBlock x:Name="DefinitionHeader" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="DefinitionText" FontSize="14" TextWrapping="WrapWholeWords"/>
            <TextBlock x:Name="ComparisonHeader" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <Border x:Name="ComparisonCard" Padding="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="7">
              <StackPanel Spacing="6"><TextBlock x:Name="ComparisonContext" FontSize="12" Opacity="0.72"/><TextBlock x:Name="ComparisonText" FontSize="13" TextWrapping="WrapWholeWords"/></StackPanel>
            </Border>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RelatedHeader" FontSize="12" Opacity="0.65"/><Button x:Name="CopyButton" Grid.Column="1" Click="OnCopyClick"/></Grid>
            <ItemsControl x:Name="RelatedList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="OnRelatedClick" Margin="0,0,6,6" Padding="10,4" CornerRadius="14" Content="{Binding Display}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SourcesHeader" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <Border x:Name="SourceCard" Padding="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="7">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="SourceTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SourceStatus" FontSize="11" Opacity="0.66" TextWrapping="Wrap"/></StackPanel><Button x:Name="OpenSourceButton" Grid.Column="1" Click="OnOpenSourceClick" VerticalAlignment="Center"/></Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <InfoBar x:Name="StatusBar" Grid.Row="5" Margin="0,10,0,0" IsOpen="False" IsClosable="True"/>
  </Grid>
</Page>