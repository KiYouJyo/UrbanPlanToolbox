<Page x:Class="UrbanPlanToolbox.Views.PlanningTerminologyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Padding="{StaticResource PageContentPadding}" MaxWidth="1500" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
      <Grid Grid.Row="0" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
          <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="DatasetText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap"/>
      </Grid>
      <TextBox Grid.Row="1" x:Name="SearchBox" TextChanged="OnSearchChanged" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
      <Grid x:Name="FilterGrid" Grid.Row="2" ColumnSpacing="8" HorizontalAlignment="Stretch" Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="JurisdictionBox" Grid.Row="0" Grid.Column="0" SelectionChanged="OnFilterChanged" DisplayMemberPath="Display" SelectedValuePath="Value"/>
        <ComboBox x:Name="CategoryBox" Grid.Row="0" Grid.Column="1" SelectionChanged="OnFilterChanged" DisplayMemberPath="Display" SelectedValuePath="Value"/>
      </Grid>
      <InfoBar Grid.Row="3" x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="False" Margin="0,6,0,0"/>
      <Grid Grid.Row="4" x:Name="ContentGrid" ColumnSpacing="16" Margin="0,6,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.62*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" x:Name="ResultsPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" x:Name="ResultsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,6"/>
          <ListView Grid.Row="1" x:Name="ResultsList" SelectionMode="None" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding}" Click="OnResultClick" Style="{StaticResource CardActionButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="{StaticResource CardContentPadding}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding ZhCN}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding JaJP}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EnUS}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Badge}" FontSize="12" Opacity="0.75"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" x:Name="EmptyText" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </Grid>
        <ScrollViewer Grid.Row="0" x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="0">
          <StackPanel x:Name="DetailPanel" Spacing="10" HorizontalAlignment="Stretch">
            <TextBlock x:Name="DetailZh" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailJa" FontSize="18" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailReading" Opacity="0.75" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailEn" FontSize="18" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="JurisdictionText"/><TextBlock x:Name="EquivalenceText" TextWrapping="Wrap"/></StackPanel>
            <Button x:Name="CopyButton" Click="OnCopyClick" HorizontalAlignment="Left"/>
            <TextBlock x:Name="DefinitionHeader" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ComboBox x:Name="DefinitionLanguageBox" SelectionChanged="OnDefinitionLanguageChanged" DisplayMemberPath="Display" SelectedValuePath="Value"/>
            <TextBlock x:Name="DefinitionText" TextWrapping="WrapWholeWords" FontSize="15"/>
            <InfoBar x:Name="ReviewBar" IsOpen="False" Severity="Warning" IsClosable="False"/>
            <TextBlock x:Name="RelatedHeader" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ItemsControl x:Name="RelatedList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Tag="{Binding}" Click="OnRelatedClick" Style="{StaticResource CardActionButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="{StaticResource CardContentPadding}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ComparisonHeader" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ItemsControl x:Name="ComparisonList">
              <ItemsControl.ItemTemplate><DataTemplate><Border Padding="{StaticResource CardContentPadding}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{StaticResource CardCornerRadius}"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SourcesHeader" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ItemsControl x:Name="SourcesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Source.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Source.Authority}" Opacity="0.75" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Source.Status}" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Tag="{Binding}" Click="OnSourceClick" Content="{Binding OpenText}" Visibility="{Binding OpenVisibility}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
  </Grid>
</Page>
