<Page x:Class="UrbanPlanToolbox.Views.CoordinateBatchFormatConverterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer><StackPanel Padding="24" Spacing="12">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
    <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PasteButton" Click="OnPaste"/><Button x:Name="ImportButton" Click="OnImport"/></StackPanel>
    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="OrderBox" Grid.Column="0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="FormatBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnOutputSettingsChanged"/>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="PrecisionBox" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnOutputSettingsChanged"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConvertButton" Click="OnConvert"/><Button x:Name="CopyButton" Click="OnCopy"/><Button x:Name="ExportButton" Click="OnExport"/></StackPanel>
    <TextBlock x:Name="StatsText" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <ListView x:Name="ResultsList" SelectionMode="None" IsItemClickEnabled="False">
      <ListView.ItemTemplate><DataTemplate><Border Padding="8" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding OriginalText}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Longitude}"/><TextBlock Grid.Column="3" Text="{Binding Latitude}"/><TextBlock Grid.Column="4" Text="{Binding Format}"/><TextBlock Grid.Column="5" Text="{Binding Status}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock x:Name="GisHintText" TextWrapping="Wrap" Opacity="0.75"/>
    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
  </StackPanel></ScrollViewer>
</Page>
