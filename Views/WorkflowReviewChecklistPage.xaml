<Page x:Class="UrbanPlanToolbox.Views.WorkflowReviewChecklistPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
  <Grid Padding="24" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="12">
      <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
      <Button x:Name="NewButton" Click="OnNewClick"/>
      <TextBlock x:Name="ListStatus" TextWrapping="Wrap"/>
      <ListView x:Name="ChecklistList" SelectionChanged="OnChecklistSelectionChanged" HorizontalContentAlignment="Stretch"/>
    </StackPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBox x:Name="NameBox" TextChanged="OnDraftChanged"/>
        <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnDraftChanged"/>
        <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="UsageBox" DisplayMemberPath="Display" SelectionChanged="OnUsageChanged"/>
        <TextBlock x:Name="StatisticsText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
        <StackPanel x:Name="SectionsPanel" Spacing="12"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AddSectionButton" Click="OnAddSectionClick"/>
          <Button x:Name="SaveButton" Click="OnSaveClick"/>
          <Button x:Name="ResetButton" Click="OnResetClick"/>
          <Button x:Name="CopyButton" Click="OnCopyClick"/>
          <Button x:Name="DeleteButton" Click="OnDeleteClick"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
