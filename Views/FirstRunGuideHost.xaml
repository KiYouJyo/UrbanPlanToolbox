<UserControl x:Class="UrbanPlanToolbox.Views.FirstRunGuideHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True"
             KeyDown="OnKeyDown">
  <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24">
    <Border Style="{StaticResource SettingsSectionCardStyle}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="900" MaxHeight="680" Padding="32">
      <Grid RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock x:Name="StepText" Style="{StaticResource SettingsDescriptionStyle}"/>
            <TextBlock x:Name="GuideTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="FirstRunGuideTitle"/>
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="1" Click="OnClose" AutomationProperties.AutomationId="FirstRunGuideClose"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20">
            <TextBlock x:Name="GuideBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="FirstRunGuideBody"/>
            <ItemsControl x:Name="FeatureList">
              <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4"><FontIcon Glyph="&#xE73E;"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="PrivacyButton" Click="OnPrivacy" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="SkipButton" Grid.Column="1" Click="OnSkip"/>
          <Button x:Name="BackButton" Grid.Column="2" Click="OnBack"/>
          <Button x:Name="NextButton" Grid.Column="3" Click="OnNext"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
