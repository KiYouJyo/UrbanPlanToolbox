<Page x:Class="UrbanPlanToolbox.Views.DesignToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Padding="32" Spacing="12">
    <TextBlock Text="设计工具" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock Text="当前已上线工具" Style="{StaticResource SubtitleTextBlockStyle}" />
    <ListView x:Name="ToolsList" IsItemClickEnabled="True" ItemClick="OnToolClick" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Padding="4,8" Spacing="4">
            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </StackPanel>
</Page>
