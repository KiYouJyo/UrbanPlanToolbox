<Window x:Class="UrbanPlanToolbox.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Border x:Name="RootLayout"
          Background="{ThemeResource LayerFillColorAltBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="4">
    <StackPanel Spacing="0">
      <Button x:Name="OpenButton" Click="OnOpen" Height="32" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="8,0" Background="Transparent"
              BorderThickness="0" CornerRadius="4">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="OpenText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>

      <Border Height="1" Margin="8,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

      <Button x:Name="RecorderButton" Click="OnRecorder" Height="32" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="8,0" Background="Transparent"
              BorderThickness="0" CornerRadius="4">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <SymbolIcon x:Name="RecorderCheck" Symbol="Accept" Width="16" Height="16" VerticalAlignment="Center"/>
          <TextBlock x:Name="RecorderText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>

      <Border Height="1" Margin="8,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

      <Button x:Name="SettingsButton" Click="OnSettings" Height="32" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="8,0" Background="Transparent"
              BorderThickness="0" CornerRadius="4">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SettingsText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>

      <Button x:Name="ExitButton" Click="OnExit" Height="32" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="8,0" Background="Transparent"
              BorderThickness="0" CornerRadius="4">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ExitText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</Window>