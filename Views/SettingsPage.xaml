<Page x:Class="UrbanPlanToolbox.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Style="{StaticResource PageContentStackPanelStyle}" MaxWidth="960" HorizontalAlignment="Stretch">
  <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/>
  <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel Spacing="16">
   <StackPanel Spacing="4"><TextBlock x:Name="AppearanceLanguageTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="AppearanceLanguageDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
   <Grid ColumnSpacing="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4"><TextBlock x:Name="ThemeLabel" Style="{StaticResource SettingsRowLabelStyle}"/><TextBlock x:Name="ThemeDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
    <ComboBox x:Name="ThemeBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged"><ComboBoxItem Tag="System" x:Uid="Setting_Theme_System"/><ComboBoxItem Tag="Light" x:Uid="Setting_Theme_Light"/><ComboBoxItem Tag="Dark" x:Uid="Setting_Theme_Dark"/></ComboBox>
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="ThemeRowWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ThemeBox.(Grid.Row)" Value="0"/><Setter Target="ThemeBox.(Grid.Column)" Value="1"/><Setter Target="ThemeBox.HorizontalAlignment" Value="Right"/><Setter Target="ThemeBox.Width" Value="260"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   </Grid>
   <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
   <Grid ColumnSpacing="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4"><TextBlock x:Name="LanguageLabel" Style="{StaticResource SettingsRowLabelStyle}"/><TextBlock x:Name="LanguageDescription" Style="{StaticResource SettingsDescriptionStyle}"/><TextBlock x:Name="LanguageRestartHint" Style="{StaticResource SettingsDescriptionStyle}" Visibility="Collapsed"/></StackPanel>
    <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged"><ComboBoxItem Tag="system" x:Uid="Setting_Language_System"/><ComboBoxItem Tag="zh-CN" x:Uid="Setting_Language_ZhCn"/><ComboBoxItem Tag="ja-JP" x:Uid="Setting_Language_JaJp"/><ComboBoxItem Tag="en-US" x:Uid="Setting_Language_EnUs"/></ComboBox>
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="LanguageRowWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="LanguageBox.(Grid.Row)" Value="0"/><Setter Target="LanguageBox.(Grid.Column)" Value="1"/><Setter Target="LanguageBox.HorizontalAlignment" Value="Right"/><Setter Target="LanguageBox.Width" Value="260"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   </Grid>
   <TextBlock x:Name="AppearanceLanguageSummary" Style="{StaticResource SettingsDescriptionStyle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel Spacing="16">
   <StackPanel Spacing="4"><TextBlock x:Name="DisplayCalculationTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="DisplayCalculationDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
   <Grid ColumnSpacing="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4"><TextBlock x:Name="DecimalLabel" Style="{StaticResource SettingsRowLabelStyle}"/><TextBlock x:Name="DecimalDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
    <ComboBox x:Name="DecimalBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox>
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="DecimalRowWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="DecimalBox.(Grid.Row)" Value="0"/><Setter Target="DecimalBox.(Grid.Column)" Value="1"/><Setter Target="DecimalBox.HorizontalAlignment" Value="Right"/><Setter Target="DecimalBox.Width" Value="260"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   </Grid>
   <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
   <Grid ColumnSpacing="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4"><TextBlock x:Name="AutoCalculateLabel" Style="{StaticResource SettingsRowLabelStyle}"/><TextBlock x:Name="AutoCalculateDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
    <ToggleSwitch x:Name="AutoCalculateToggle" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Toggled="OnSettingChanged"/>
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="AutoCalculateRowWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="AutoCalculateToggle.(Grid.Row)" Value="0"/><Setter Target="AutoCalculateToggle.(Grid.Column)" Value="1"/><Setter Target="AutoCalculateToggle.HorizontalAlignment" Value="Right"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   </Grid>
   <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/><StackPanel Spacing="4"><TextBlock x:Name="RestoreDefaultsLabel" Style="{StaticResource SettingsRowLabelStyle}"/><TextBlock x:Name="RestoreDefaultsDescription" Style="{StaticResource SettingsDescriptionStyle}"/><Button x:Uid="Action_RestoreDefaults" Click="OnRestore" HorizontalAlignment="Left"/></StackPanel><TextBlock x:Name="StatusText" Style="{StaticResource SettingsDescriptionStyle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource SettingsSectionCardStyle}"><StackPanel Spacing="16">
   <StackPanel Spacing="4"><TextBlock x:Name="DataManagementTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="DataManagementDescription" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
   <Grid x:Name="DataActions" ColumnSpacing="8" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Uid="DataManagement_Export" x:Name="ExportButton" Grid.Row="0" Click="OnExport"/><Button x:Uid="DataManagement_Import" x:Name="ImportButton" Grid.Row="1" Click="OnImport"/><Button x:Name="ClearDataButton" Grid.Row="2" Click="OnClearData"/>
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="DataActionsWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ImportButton.(Grid.Row)" Value="0"/><Setter Target="ImportButton.(Grid.Column)" Value="1"/><Setter Target="ClearDataButton.(Grid.Row)" Value="0"/><Setter Target="ClearDataButton.(Grid.Column)" Value="2"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   </Grid>
   <InfoBar x:Name="DataStatusBar" IsOpen="False"/>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</Page>
