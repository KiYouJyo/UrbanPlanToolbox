<Page x:Class="UrbanPlanToolbox.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UrbanPlanToolbox.Controls">
  <ScrollViewer HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid x:Name="SettingsLayoutRoot" HorizontalAlignment="Stretch" Padding="24,16,24,32">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="SettingsNarrow">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="SettingsWide">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="ThemeBox.(Grid.Row)" Value="0"/>
              <Setter Target="ThemeBox.(Grid.Column)" Value="1"/>
              <Setter Target="ThemeBox.Width" Value="280"/>
              <Setter Target="LanguageBox.(Grid.Row)" Value="0"/>
              <Setter Target="LanguageBox.(Grid.Column)" Value="1"/>
              <Setter Target="LanguageBox.Width" Value="280"/>
              <Setter Target="MilestoneNotificationsRepeatBox.(Grid.Row)" Value="0"/>
              <Setter Target="MilestoneNotificationsRepeatBox.(Grid.Column)" Value="1"/>
              <Setter Target="MilestoneNotificationsRepeatBox.Width" Value="280"/>
              <Setter Target="ImportButton.(Grid.Row)" Value="0"/>
              <Setter Target="ImportButton.(Grid.Column)" Value="1"/>
              <Setter Target="ClearDataButton.(Grid.Row)" Value="0"/>
              <Setter Target="ClearDataButton.(Grid.Column)" Value="2"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel x:Name="SettingsContent"
                  HorizontalAlignment="Left"
                  MaxWidth="900"
                  Spacing="16">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/>

        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock x:Name="AppearanceLanguageTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
              <TextBlock x:Name="AppearanceLanguageDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
            </StackPanel>
            <Grid ColumnSpacing="24" RowSpacing="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock x:Name="ThemeLabel" Style="{StaticResource SettingsRowLabelStyle}"/>
                <TextBlock x:Name="ThemeDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
              </StackPanel>
              <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="ThemeBox"
                        Grid.Row="1"
                        Grid.Column="0"
                        MinWidth="240"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        SelectionChanged="OnThemeChanged">
                <ComboBoxItem Tag="System" x:Uid="Setting_Theme_System"/>
                <ComboBoxItem Tag="Light" x:Uid="Setting_Theme_Light"/>
                <ComboBoxItem Tag="Dark" x:Uid="Setting_Theme_Dark"/>
              </ComboBox>
            </Grid>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Grid ColumnSpacing="24" RowSpacing="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource SettingsRowLabelStyle}"/>
                <TextBlock x:Name="LanguageDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
              </StackPanel>
              <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="LanguageBox"
                        Grid.Row="1"
                        Grid.Column="0"
                        MinWidth="240"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        SelectionChanged="OnLanguageChanged">
                <ComboBoxItem Tag="system" x:Uid="Setting_Language_System"/>
                <ComboBoxItem Tag="zh-CN" x:Uid="Setting_Language_ZhCn"/>
                <ComboBoxItem Tag="ja-JP" x:Uid="Setting_Language_JaJp"/>
                <ComboBoxItem Tag="en-US" x:Uid="Setting_Language_EnUs"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12">
            <TextBlock x:Name="ResidencyTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ToggleSwitch x:Name="BackgroundResidencyToggle" Toggled="OnBackgroundResidencyToggled"/>
            <ToggleSwitch x:Name="SilentStartupToggle" Toggled="OnSilentStartupToggled"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock x:Name="MilestoneNotificationsTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
              <TextBlock x:Name="MilestoneNotificationsDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid ColumnSpacing="24" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="MilestoneNotificationsLabel" Grid.Column="0" Style="{StaticResource SettingsRowLabelStyle}" VerticalAlignment="Center"/>
              <ToggleSwitch x:Name="MilestoneNotificationsToggle" Grid.Column="1" Toggled="OnMilestoneNotificationsToggled"/>
            </Grid>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Grid ColumnSpacing="24" RowSpacing="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="MilestoneNotificationsRepeatLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsRowLabelStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="MilestoneNotificationsRepeatBox"
                        Grid.Row="1"
                        Grid.Column="0"
                        MinWidth="240"
                        MaxWidth="360"
                        SelectionChanged="OnMilestoneNotificationsRepeatChanged">
                <ComboBoxItem Tag="None" x:Uid="Settings_MilestoneNotificationsRepeatNone"/>
                <ComboBoxItem Tag="Hours6" x:Uid="Settings_MilestoneNotificationsRepeatHours6"/>
                <ComboBoxItem Tag="Hours12" x:Uid="Settings_MilestoneNotificationsRepeatHours12"/>
                <ComboBoxItem Tag="Hours24" x:Uid="Settings_MilestoneNotificationsRepeatHours24"/>
                <ComboBoxItem Tag="Days3" x:Uid="Settings_MilestoneNotificationsRepeatDays3"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock x:Name="DataManagementTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
              <TextBlock x:Name="DataManagementDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
            </StackPanel>
            <Grid x:Name="DataActions" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Uid="DataManagement_Export" x:Name="ExportButton" Grid.Row="0" HorizontalAlignment="Left" Click="OnExport"/>
              <Button x:Uid="DataManagement_Import" x:Name="ImportButton" Grid.Row="1" HorizontalAlignment="Left" Click="OnImport"/>
              <Button x:Name="ClearDataButton" Grid.Row="2" HorizontalAlignment="Left" Click="OnClearData"/>
            </Grid>
            <InfoBar x:Name="DataStatusBar" IsOpen="False"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock x:Name="ApplicationSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
              <TextBlock x:Name="ApplicationSettingsDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock x:Name="RestoreDefaultsLabel" Style="{StaticResource SettingsRowLabelStyle}"/>
              <TextBlock x:Name="RestoreDefaultsDescription" Style="{StaticResource SettingsDescriptionStyle}"/>
              <Button x:Uid="Action_RestoreDefaults" Click="OnRestore" HorizontalAlignment="Left"/>
            </StackPanel>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <StackPanel Spacing="4">
              <TextBlock x:Name="FirstRunGuideLabel" Style="{StaticResource SettingsRowLabelStyle}"/>
              <TextBlock x:Name="FirstRunGuideDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"/>
              <Button x:Name="ReopenFirstRunGuideButton" Click="OnReopenFirstRunGuide" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource SettingsDescriptionStyle}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
