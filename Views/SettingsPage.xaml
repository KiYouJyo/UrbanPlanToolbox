<Page x:Class="UrbanPlanToolbox.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Padding="32" Spacing="16"><TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
 <ComboBox x:Name="ThemeBox" Header="主题" SelectionChanged="OnSettingChanged"><ComboBoxItem Tag="System" Content="跟随系统" /><ComboBoxItem Tag="Light" Content="浅色" /><ComboBoxItem Tag="Dark" Content="深色" /></ComboBox>
 <ComboBox x:Name="DecimalBox" Header="计算结果保留小数位" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="0" /><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /></ComboBox>
 <ToggleSwitch x:Name="AutoCalculateToggle" Header="输入变化时自动重新计算" Toggled="OnSettingChanged" />
 <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存设置" Click="OnSave" /><Button Content="恢复默认设置" Click="OnRestore" /></StackPanel><TextBlock x:Name="StatusText" />
 </StackPanel>
</Page>
