<Page x:Class="UrbanPlanToolbox.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="16">
    <TextBlock x:Uid="Home_Title" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock x:Uid="Home_Subtitle" Style="{StaticResource SubtitleTextBlockStyle}" />
    <TextBlock x:Uid="Home_Version" TextWrapping="Wrap" />
    <Button x:Uid="Home_OpenCalculator" Click="OnOpenCalculator" HorizontalAlignment="Left" />
    <Button x:Uid="Home_OpenUnitScale" Click="OnOpenUnitScale" HorizontalAlignment="Left" />
    <TextBlock x:Uid="Home_UpcomingTitle" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <InfoBar x:Uid="Home_UpcomingLandBalance" IsOpen="True" /><InfoBar x:Uid="Home_UpcomingParking" Grid.Column="1" IsOpen="True" />
    </Grid>
  </StackPanel></ScrollViewer>
</Page>
