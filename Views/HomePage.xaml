<Page x:Class="UrbanPlanToolbox.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="16">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Uid="ProjectHome_Title" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock x:Uid="ProjectHome_Description" TextWrapping="Wrap" /></StackPanel>
      <Button x:Uid="ProjectHome_NewProject" Grid.Column="1" Click="OnNewProject" VerticalAlignment="Top" />
    </Grid>
    <InfoBar x:Name="StatusBar" IsOpen="False" />
    <TextBlock x:Name="EmptyText" x:Uid="ProjectHome_Empty" TextWrapping="Wrap" Visibility="Collapsed" />
    <ItemsControl x:Name="ProjectsList">
      <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Project}" Click="OnOpenProject" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Padding="16">
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding TypeAndArea}" TextWrapping="Wrap"/><TextBlock Text="{Binding Statistics}"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Updated}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </Button></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
</Page>
