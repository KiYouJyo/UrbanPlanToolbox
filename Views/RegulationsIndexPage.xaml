<Page x:Class="UrbanPlanToolbox.Views.RegulationsIndexPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="24" Spacing="12">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/><Button x:Name="FavoriteButton" Grid.Column="1"/></Grid>
    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/><TextBlock x:Name="StatsText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnTextChanged"/><ComboBox x:Name="RegionBox" Grid.Column="1" SelectionChanged="OnSelectionChanged"/><ComboBox x:Name="TopicBox" Grid.Column="2" SelectionChanged="OnSelectionChanged"/></Grid>
    <ListView x:Name="EntriesList" IsItemClickEnabled="True" ItemClick="OnEntryClick" SelectionMode="None" MaxHeight="520"/>
    <TextBlock x:Name="PortalsHeader" Style="{StaticResource SubtitleTextBlockStyle}"/><ItemsControl x:Name="PortalsList"/><TextBlock x:Name="NotesHeader" Style="{StaticResource SubtitleTextBlockStyle}"/><ItemsControl x:Name="NotesList"/>
  </StackPanel></ScrollViewer>
</Page>
