<Page x:Class="UrbanPlanToolbox.Views.PlanningCalculatorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
 <ScrollViewer><StackPanel Style="{StaticResource PageContentStackPanelStyle}">
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" /><controls:FavoriteButton x:Name="FavoriteButton" Grid.Column="1" VerticalAlignment="Top" /></Grid>
  <TextBlock x:Uid="Page_PlanningCalculator_Description" TextWrapping="Wrap" />
  <Grid ColumnSpacing="20" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBox x:Name="SiteAreaBox" /><TextBox x:Name="FootprintBox" Grid.Column="1" />
   <TextBox x:Name="TotalAreaBox" Grid.Row="1" /><TextBox x:Name="AboveAreaBox" Grid.Row="1" Grid.Column="1" />
   <TextBox x:Name="UndergroundAreaBox" Grid.Row="2" /><TextBox x:Name="GreenAreaBox" Grid.Row="2" Grid.Column="1" />
   <TextBox x:Name="HouseholdsBox" Grid.Row="3" /><TextBox x:Name="PopulationBox" Grid.Row="3" Grid.Column="1" />
   <TextBox x:Name="PeoplePerHouseholdBox" Grid.Row="4" /><TextBox x:Name="ParkingTotalBox" Grid.Row="4" Grid.Column="1" />
   <TextBox x:Name="SurfaceParkingBox" Grid.Row="5" /><TextBox x:Name="UndergroundParkingBox" Grid.Row="5" Grid.Column="1" />
   <TextBox x:Name="PublicServiceBox" Grid.Row="6" /><CheckBox x:Name="UseTotalAreaCheck" Grid.Row="6" Grid.Column="1" x:Uid="Field_UseTotalAreaForPublicService" VerticalAlignment="Bottom" />
  </Grid>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="Action_Calculate" Click="OnCalculate" /><Button x:Uid="Action_FillSample" Click="OnSample" /><Button x:Uid="Action_Reset" Click="OnClear" /><Button x:Uid="Action_CopyResults" Click="OnCopy" /></StackPanel>
  <StackPanel x:Name="ProjectActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button x:Uid="Snapshot_SaveToProject" Click="OnSaveToProject"/><Button x:Uid="Snapshot_ReturnToProject" Click="OnReturnToProject"/></StackPanel>
  <InfoBar x:Name="StaleBar" x:Uid="Status_ResultStaleTitle" Severity="Informational" IsOpen="False" /><InfoBar x:Name="ErrorBar" x:Uid="Error_InputTitle" Severity="Error" IsOpen="False" /><InfoBar x:Name="WarningBar" x:Uid="Status_HintTitle" Severity="Warning" IsOpen="False" />
  <TextBlock x:Uid="Result_ResultsHeader" Style="{StaticResource SubtitleTextBlockStyle}" /><Border Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock x:Name="ResultsText" TextWrapping="Wrap" FontFamily="Consolas" /></Border>
 </StackPanel></ScrollViewer>
</Page>
