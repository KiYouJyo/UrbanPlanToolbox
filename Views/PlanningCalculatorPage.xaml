<Page x:Class="UrbanPlanToolbox.Views.PlanningCalculatorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UrbanPlanToolbox.Controls">
 <ScrollViewer><StackPanel Padding="32" Spacing="12">
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="规划指标快速计算器" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" /><controls:FavoriteButton x:Name="FavoriteButton" Grid.Column="1" VerticalAlignment="Top" /></Grid>
  <TextBlock Text="默认以地上建筑面积作为计容建筑面积；不同地区认定可能不同，请以当地现行规划管理规定为准。" TextWrapping="Wrap" />
  <Grid ColumnSpacing="20" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBox x:Name="SiteAreaBox" Header="用地面积（㎡）" /><TextBox x:Name="FootprintBox" Grid.Column="1" Header="建筑基底面积（㎡）" />
   <TextBox x:Name="TotalAreaBox" Grid.Row="1" Header="总建筑面积（㎡）" /><TextBox x:Name="AboveAreaBox" Grid.Row="1" Grid.Column="1" Header="地上建筑面积（㎡）" />
   <TextBox x:Name="UndergroundAreaBox" Grid.Row="2" Header="地下建筑面积（㎡）" /><TextBox x:Name="GreenAreaBox" Grid.Row="2" Grid.Column="1" Header="绿地面积（㎡）" />
   <TextBox x:Name="HouseholdsBox" Grid.Row="3" Header="户数（户）" /><TextBox x:Name="PopulationBox" Grid.Row="3" Grid.Column="1" Header="规划人口（人）" />
   <TextBox x:Name="PeoplePerHouseholdBox" Grid.Row="4" Header="户均人口（人/户）" /><TextBox x:Name="ParkingTotalBox" Grid.Row="4" Grid.Column="1" Header="机动车停车位总数（个）" />
   <TextBox x:Name="SurfaceParkingBox" Grid.Row="5" Header="地上停车位（个）" /><TextBox x:Name="UndergroundParkingBox" Grid.Row="5" Grid.Column="1" Header="地下停车位（个）" />
   <TextBox x:Name="PublicServiceBox" Grid.Row="6" Header="公共服务设施建筑面积（㎡）" /><CheckBox x:Name="UseTotalAreaCheck" Grid.Row="6" Grid.Column="1" Content="按总建筑面积计算公共服务占比" VerticalAlignment="Bottom" />
  </Grid>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="计算" Click="OnCalculate" /><Button Content="填入示例" Click="OnSample" /><Button Content="清空" Click="OnClear" /><Button Content="复制结果" Click="OnCopy" /></StackPanel>
  <InfoBar x:Name="StaleBar" Title="结果待更新" Severity="Informational" IsOpen="False" Message="输入已变化；请点击“计算”更新结果。" /><InfoBar x:Name="ErrorBar" Title="输入错误" Severity="Error" IsOpen="False" /><InfoBar x:Name="WarningBar" Title="提示" Severity="Warning" IsOpen="False" />
  <TextBlock Text="计算结果" Style="{StaticResource SubtitleTextBlockStyle}" /><Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock x:Name="ResultsText" Text="尚未计算" TextWrapping="Wrap" FontFamily="Consolas" /></Border>
 </StackPanel></ScrollViewer>
</Page>
