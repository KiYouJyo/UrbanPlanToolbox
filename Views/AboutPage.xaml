<Page x:Class="UrbanPlanToolbox.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <Grid x:Name="AboutLayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="24,16,24,32">
      <StackPanel x:Name="AboutContent" HorizontalAlignment="Left" MaxWidth="900" Spacing="16">
        <TextBlock x:Uid="Page_About_Title" Style="{StaticResource TitleTextBlockStyle}" />
        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
              <Image Source="/Assets/Square44x44Logo.scale-200.png" Width="48" Height="48" VerticalAlignment="Top" automation:AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="2"><TextBlock Text="UrbanPlanToolbox" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="About_ProductName" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Uid="About_Tagline" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <TextBlock x:Uid="About_AppInformation" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="16" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="130"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Uid="About_DisplayVersionLabel" VerticalAlignment="Top"/><TextBlock x:Name="DisplayVersionText" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_PackageVersionLabel" Grid.Row="1" VerticalAlignment="Top"/><TextBlock x:Name="PackageVersionText" Grid.Row="1" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_ArchitectureLabel" Grid.Row="2" VerticalAlignment="Top"/><TextBlock x:Name="ArchitectureText" Grid.Row="2" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_ChannelLabel" Grid.Row="3" VerticalAlignment="Top"/><TextBlock x:Name="ChannelText" Grid.Row="3" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_PublisherLabel" Grid.Row="4" VerticalAlignment="Top"/><TextBlock x:Name="PublisherText" Grid.Row="4" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_TechnologyLabel" Grid.Row="5" VerticalAlignment="Top"/><TextBlock x:Uid="About_TechnologyValue" Grid.Row="5" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock x:Uid="About_CopyrightLabel" Grid.Row="6" VerticalAlignment="Top"/><TextBlock Text="Copyright © 2026 KiYouJyo" Grid.Row="6" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Uid="About_PrivacyTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="About_PrivacySummary" TextWrapping="Wrap"/><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PrivacyButton" Click="OnOpenPrivacy"/><Button x:Name="NoticesButton" Grid.Column="1" Click="OnOpenNotices"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Uid="About_OpenSourceTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="About_OpenSourceSummary" TextWrapping="Wrap"/><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="RepositoryButton" Click="OnOpenRepository"/><Button x:Name="ReleasesButton" Grid.Column="1" Click="OnOpenReleases"/><Button x:Name="IssuesButton" Grid.Row="1" Click="OnOpenIssues"/><Button x:Name="LicenseButton" Grid.Row="1" Grid.Column="1" Click="OnOpenLicense"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Uid="About_UpdateTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="16" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="130"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Uid="About_CurrentVersionLabel" VerticalAlignment="Top"/><TextBlock x:Name="UpdateVersionText" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/><TextBlock x:Uid="About_UpdateSourceLabel" Grid.Row="1" VerticalAlignment="Top"/><TextBlock x:Name="UpdateSourceText" Grid.Row="1" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/><TextBlock x:Uid="About_UpdateStatusLabel" Grid.Row="2" VerticalAlignment="Top"/><TextBlock x:Name="UpdateStatusText" Grid.Row="2" Grid.Column="1" MinWidth="0" TextWrapping="Wrap" VerticalAlignment="Top"/></Grid><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Visibility="Collapsed" automation:AutomationProperties.Name="Update progress"/><TextBlock x:Name="UpdateDetailText" TextWrapping="Wrap"/><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CheckUpdateButton" Click="OnCheckUpdate"/><Button x:Name="InstallUpdateButton" Grid.Column="1" Click="OnInstallUpdate" Visibility="Collapsed"/><Button x:Name="OpenReleasesButton" Grid.Column="2" Click="OnOpenReleases" Visibility="Collapsed"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Uid="About_DiagnosticsTitle" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="About_DiagnosticsSummary" TextWrapping="Wrap"/><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CopyDiagnosticsButton" Click="OnCopyDiagnostics"/><Button x:Name="OpenLogsButton" Grid.Column="1" Click="OnOpenLogs"/></Grid></StackPanel></Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
