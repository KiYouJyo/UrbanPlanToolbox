<Page x:Class="UrbanPlanToolbox.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <ScrollViewer HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid x:Name="AboutLayoutRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top"
          Padding="24,16,24,32">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="UpdateLayoutStates">
          <VisualState x:Name="CompactUpdateLayout">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="UpdateNotesPanel.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="UpdateMetadataCard.(Grid.Row)" Value="1" />
              <Setter Target="UpdateMetadataCard.(Grid.Column)" Value="0" />
              <Setter Target="UpdateMetadataCard.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="UpdateMetadataCard.MaxWidth" Value="10000" />
              <Setter Target="UpdateMetadataCard.Margin" Value="0,12,0,0" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="WideUpdateLayout">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="980" /></VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="AboutResponsiveStates">
          <VisualState x:Name="AboutCompact">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="AppInfoPackage.(Grid.Row)" Value="1" /><Setter Target="AppInfoPackage.(Grid.Column)" Value="0" />
              <Setter Target="AppInfoArchitecture.(Grid.Row)" Value="2" /><Setter Target="AppInfoArchitecture.(Grid.Column)" Value="0" />
              <Setter Target="AppInfoChannel.(Grid.Row)" Value="3" /><Setter Target="AppInfoChannel.(Grid.Column)" Value="0" />
              <Setter Target="AppInfoPublisher.(Grid.Row)" Value="4" /><Setter Target="AppInfoPublisher.(Grid.Column)" Value="0" />
              <Setter Target="AppInfoTechnology.(Grid.Row)" Value="5" /><Setter Target="AppInfoTechnology.(Grid.Column)" Value="0" />
              <Setter Target="RepositoryTile.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="ReleasesTile.(Grid.Row)" Value="1" /><Setter Target="ReleasesTile.(Grid.Column)" Value="0" /><Setter Target="ReleasesTile.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="IssuesTile.(Grid.Row)" Value="2" /><Setter Target="IssuesTile.(Grid.Column)" Value="0" /><Setter Target="IssuesTile.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="LicenseTile.(Grid.Row)" Value="3" /><Setter Target="LicenseTile.(Grid.Column)" Value="0" /><Setter Target="LicenseTile.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="PrivacyButton.(Grid.Row)" Value="1" /><Setter Target="PrivacyButton.(Grid.Column)" Value="0" /><Setter Target="PrivacyButton.HorizontalAlignment" Value="Left" />
              <Setter Target="NoticesButton.(Grid.Row)" Value="1" /><Setter Target="NoticesButton.(Grid.Column)" Value="0" /><Setter Target="NoticesButton.HorizontalAlignment" Value="Left" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="AboutWide">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="520" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="AppInfoPackage.(Grid.Row)" Value="0" /><Setter Target="AppInfoPackage.(Grid.Column)" Value="1" />
              <Setter Target="AppInfoArchitecture.(Grid.Row)" Value="0" /><Setter Target="AppInfoArchitecture.(Grid.Column)" Value="2" />
              <Setter Target="AppInfoChannel.(Grid.Row)" Value="1" /><Setter Target="AppInfoChannel.(Grid.Column)" Value="0" />
              <Setter Target="AppInfoPublisher.(Grid.Row)" Value="1" /><Setter Target="AppInfoPublisher.(Grid.Column)" Value="1" />
              <Setter Target="AppInfoTechnology.(Grid.Row)" Value="1" /><Setter Target="AppInfoTechnology.(Grid.Column)" Value="2" />
              <Setter Target="RepositoryTile.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="ReleasesTile.(Grid.Row)" Value="0" /><Setter Target="ReleasesTile.(Grid.Column)" Value="1" /><Setter Target="ReleasesTile.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="IssuesTile.(Grid.Row)" Value="1" /><Setter Target="IssuesTile.(Grid.Column)" Value="0" /><Setter Target="IssuesTile.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="LicenseTile.(Grid.Row)" Value="1" /><Setter Target="LicenseTile.(Grid.Column)" Value="1" /><Setter Target="LicenseTile.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PrivacyButton.(Grid.Row)" Value="0" /><Setter Target="PrivacyButton.(Grid.Column)" Value="1" /><Setter Target="PrivacyButton.HorizontalAlignment" Value="Right" />
              <Setter Target="NoticesButton.(Grid.Row)" Value="0" /><Setter Target="NoticesButton.(Grid.Column)" Value="1" /><Setter Target="NoticesButton.HorizontalAlignment" Value="Right" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <StackPanel x:Name="AboutContent" HorizontalAlignment="Left" MaxWidth="1000" Spacing="16">
        <TextBlock x:Uid="Page_About_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Border x:Name="ApplicationInformationCard" Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="0" /></Grid.ColumnDefinitions>
              <Image x:Name="ProductLogo" Width="48" Height="48" VerticalAlignment="Top" automation:AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="2">
                <TextBlock Text="UrbanPlanToolbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="About_ProductName" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="About_Tagline" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
              <Grid x:Name="AppInformationGrid" ColumnSpacing="20" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="*" MinWidth="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="AppInfoDisplay" Grid.Row="0" Grid.Column="0" Spacing="2"><TextBlock x:Uid="About_DisplayVersionLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="DisplayVersionText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="AppInfoPackage" Grid.Row="0" Grid.Column="1" Spacing="2"><TextBlock x:Uid="About_PackageVersionLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="PackageVersionText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="AppInfoArchitecture" Grid.Row="0" Grid.Column="2" Spacing="2"><TextBlock x:Uid="About_ArchitectureLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="ArchitectureText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="AppInfoChannel" Grid.Row="1" Grid.Column="0" Spacing="2"><TextBlock x:Uid="About_ChannelLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="ChannelText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="AppInfoPublisher" Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock x:Uid="About_PublisherLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="PublisherText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="AppInfoTechnology" Grid.Row="1" Grid.Column="2" Spacing="2"><TextBlock x:Uid="About_TechnologyLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Uid="About_TechnologyValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Border>
            <TextBlock x:Uid="About_CopyrightText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border x:Name="UpdateManagementCard" Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch" Padding="20">
          <StackPanel Spacing="16">
            <TextBlock x:Uid="About_UpdateTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="0" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" MinWidth="0"><TextBlock x:Uid="About_CurrentVersionLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="UpdateVersionText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,8" />
                <StackPanel Grid.Column="2" Spacing="2" MinWidth="0"><TextBlock x:Name="UpdateTargetLabel" x:Uid="About_UpdateTargetLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="UpdateTargetText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Border>
            <Grid x:Name="UpdateBodyGrid" ColumnSpacing="12" RowSpacing="0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border x:Name="UpdateNotesPanel" Grid.Column="0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="UpdateNotesLabel" x:Uid="About_UpdateNotesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="UpdateNotesVersionText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></Grid>
                  <ScrollViewer x:Name="UpdateNotesContainer" MaxHeight="150" MinHeight="64" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="UpdateNotesText" Margin="0,0,18,0" TextWrapping="Wrap" LineHeight="22" /></ScrollViewer>
                </StackPanel>
              </Border>
              <Border x:Name="UpdateMetadataCard" Grid.Column="1" MinWidth="220" MaxWidth="240" HorizontalAlignment="Stretch" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="2"><TextBlock x:Uid="About_UpdateSourceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="UpdateSourceText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                  <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="2"><TextBlock x:Uid="About_UpdateStatusLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /><TextBlock x:Name="UpdateStatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="CheckUpdateButton" Grid.Column="1" Click="OnCheckUpdate"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="CheckUpdateButtonProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="CheckUpdateButtonText" VerticalAlignment="Center" /></StackPanel></Button></Grid>
          </StackPanel>
        </Border>

        <Border x:Name="ProjectOpenSourceCard" Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4"><TextBlock x:Uid="About_OpenSourceTitle" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Uid="About_OpenSourceSummary" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" /></StackPanel>
            <Grid x:Name="ProjectOpenSourceGrid" ColumnSpacing="12" RowSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="*" MinWidth="0" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border x:Name="RepositoryTile" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="GitHub" Style="{StaticResource BodyStrongTextBlockStyle}" /><Button x:Name="RepositoryButton" Click="OnOpenRepository" HorizontalAlignment="Left" /></StackPanel></Border>
              <Border x:Name="ReleasesTile" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="Releases" Style="{StaticResource BodyStrongTextBlockStyle}" /><Button x:Name="ReleasesButton" Click="OnOpenReleases" HorizontalAlignment="Left" /></StackPanel></Border>
              <Border x:Name="IssuesTile" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="Issues" Style="{StaticResource BodyStrongTextBlockStyle}" /><Button x:Name="IssuesButton" Click="OnOpenIssues" HorizontalAlignment="Left" /></StackPanel></Border>
              <Border x:Name="LicenseTile" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="MIT License" Style="{StaticResource BodyStrongTextBlockStyle}" /><Button x:Name="LicenseButton" Click="OnOpenLicense" HorizontalAlignment="Left" /></StackPanel></Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="PrivacyLegalCard" Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4"><TextBlock x:Uid="About_PrivacyTitle" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Uid="About_PrivacySummary" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" /></StackPanel>
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel Spacing="14">
                <Grid ColumnSpacing="16" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="PRIVACY.md" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsRowLabelStyle}" VerticalAlignment="Center" /><Button x:Name="PrivacyButton" Grid.Row="0" Grid.Column="1" Click="OnOpenPrivacy" HorizontalAlignment="Right" /></Grid>
                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Grid ColumnSpacing="16" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="THIRD-PARTY-NOTICES.md" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsRowLabelStyle}" VerticalAlignment="Center" /><Button x:Name="NoticesButton" Grid.Row="0" Grid.Column="1" Click="OnOpenNotices" HorizontalAlignment="Right" /></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed" automation:AutomationProperties.AccessibilityView="Raw"><StackPanel><TextBlock x:Uid="About_DiagnosticsTitle" /><TextBlock x:Uid="About_DiagnosticsSummary" /><Button x:Name="CopyDiagnosticsButton" Click="OnCopyDiagnostics" /><Button x:Name="OpenLogsButton" Click="OnOpenLogs" /></StackPanel></Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>