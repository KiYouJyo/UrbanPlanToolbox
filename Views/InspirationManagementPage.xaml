<Page
    x:Class="UrbanPlanToolbox.Views.InspirationManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UrbanPlanToolbox.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStackPanelStyle}" Spacing="16">
            <StackPanel x:Name="ListPanel" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="NewButton" Grid.Column="1" Click="OnNew" VerticalAlignment="Bottom" />
                </Grid>
                <InfoBar x:Name="ListStatus" IsClosable="True" IsOpen="False" />
                <StackPanel x:Name="CardsPanel" Spacing="10" />
            </StackPanel>

            <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackButton" Click="OnBack" />
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="NameBox" TextChanged="OnChanged" />
                <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="CategoryBox" SelectionChanged="OnCategoryChanged" />
                <TextBox x:Name="DetailsBox" AcceptsReturn="True" MinHeight="180" TextWrapping="Wrap" TextChanged="OnChanged" />
                <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="ProjectBox" SelectionChanged="OnChanged" />
                <TextBlock x:Name="CreatedText" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock x:Name="UpdatedText" Opacity="0.7" TextWrapping="Wrap" />
                <InfoBar x:Name="EditorStatus" IsClosable="True" IsOpen="False" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Click="OnSave" />
                    <Button x:Name="DeleteButton" Click="OnDelete" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
