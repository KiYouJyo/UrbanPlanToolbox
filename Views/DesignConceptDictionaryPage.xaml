<Page x:Class="UrbanPlanToolbox.Views.DesignConceptDictionaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UrbanPlanToolbox.Controls">
  <Grid x:Name="Root" Padding="{StaticResource PageContentPadding}" MaxWidth="1500" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Spacing="6">
      <Button x:Name="BackButton" Click="OnBackClick" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,4"/>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="DescriptionText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="CloudVersionText" VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" MaxWidth="340"/><Button x:Name="HeaderCheckButton" Click="OnCheckUpdateClick"/></StackPanel></Grid>
    </StackPanel>
    <Border Grid.Row="1" Margin="0,14,0,0" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="CurrentSourceLabel" FontSize="12" Opacity="0.62"/><TextBlock x:Name="SourceNameText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SourceMetaText" FontSize="12" Opacity="0.76" TextWrapping="Wrap"/></StackPanel><Button x:Name="CheckButton" Grid.Column="1" Click="OnCheckUpdateClick" VerticalAlignment="Center"/><Button x:Name="ManageButton" Grid.Column="2" Click="OnManageSourceClick" VerticalAlignment="Center"/></Grid>
    </Border>
    <Grid x:Name="FilterGrid" Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="10" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnFilterChanged"/>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="ProjectTypeBox" Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="OnSelectionFilterChanged"/>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="TagBox" Grid.Column="2" DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="OnSelectionFilterChanged"/>
      <ComboBox controls:TransientComboBoxTheme.Apply="True" x:Name="SortBox" Grid.Column="3" DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="OnSelectionFilterChanged"/>
      <Button x:Name="ResetButton" Grid.Column="4" Click="OnResetFiltersClick"/>
    </Grid>
    <TextBlock x:Name="CountText" Grid.Row="3" Margin="0,8,0,8" FontSize="12" Opacity="0.66"/>
    <Grid x:Name="ContentGrid" Grid.Row="4" ColumnSpacing="16" MinHeight="0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
      <Border x:Name="ListPanel" Grid.Row="0" Grid.Column="0" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" MinHeight="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,10"><TextBlock x:Name="ListHeader" FontSize="16" FontWeight="SemiBold"/><Border Padding="10,3" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock x:Name="ListCountBadge" FontSize="12"/></Border></StackPanel><ListView Grid.Row="1" x:Name="ConceptsList" SelectionMode="Single" SelectionChanged="OnConceptSelectionChanged" HorizontalContentAlignment="Stretch" MinHeight="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Grid Padding="8,10" MinHeight="92"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Definition}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Metadata}" FontSize="10" Opacity="0.72" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding TagsText}" FontSize="10" Opacity="0.62" TextWrapping="Wrap" MaxWidth="190"/></Grid></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Grid.Row="2" x:Name="EmptyText" Margin="4,8,4,0" TextWrapping="Wrap"/></Grid>
      </Border>
      <Border x:Name="DetailPanel" Grid.Row="0" Grid.Column="1" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" MinHeight="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="11"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailMeta" FontSize="11" Opacity="0.66" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><Border Padding="10,4" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock x:Name="CategoryBadge" FontSize="12"/></Border><Button x:Name="ViewSourceButton" Click="OnViewSourceClick"/></StackPanel></Grid><Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/><TextBlock x:Name="DefinitionHeader" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="DetailDefinition" FontSize="14" TextWrapping="WrapWholeWords"/><TextBlock x:Name="ProjectTypesHeader" FontSize="12" Opacity="0.65" Margin="0,10,0,0"/><ItemsControl x:Name="ProjectTypesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,6,6" Padding="10,4" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="TagsHeader" FontSize="12" Opacity="0.65"/><ItemsControl x:Name="TagsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,6,6" Padding="10,4" CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="CaseHeader" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/><Border Padding="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="7"><TextBlock x:Name="CaseText" FontSize="13" TextWrapping="WrapWholeWords"/></Border><Button x:Name="CopyButton" Click="OnCopyClick" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <InfoBar x:Name="StatusBar" Grid.Row="5" Margin="0,10,0,0" IsOpen="False" IsClosable="True"/>
  </Grid>
</Page>
