<Page x:Class="UrbanPlanToolbox.Views.ProjectArchivePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Style="{StaticResource PageContentStackPanelStyle}">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock x:Uid="Page_ProjectArchive_Description" TextWrapping="Wrap" />
    <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Warning" />
    <TextBlock x:Name="EmptyText" x:Uid="ProjectArchive_Empty" TextWrapping="Wrap" Visibility="Collapsed" />
    <ItemsControl x:Name="ProjectsList"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Project}" Click="OnOpenProject" Style="{StaticResource CardActionButtonStyle}" Margin="0,0,0,10"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}"><TextBlock Text="{Binding Kind}"/></Border></StackPanel><TextBlock Text="{Binding TypeAndArea}" TextWrapping="Wrap"/><TextBlock Text="{Binding Statistics}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Archived}" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</Page>
