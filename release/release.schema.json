{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "product", "classification", "channels", "compatibility", "title", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "type": "object", "required": ["name", "version", "packageVersion"], "properties": { "version": { "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "packageVersion": { "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" } } },
    "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "zh-CN", "ja-JP", "en-US"] } }
  }
}
